# Environment template for docker-compose-env.yaml and docker-compose.yaml.
# 使用方式: 复制为 .env 后按需修改，或直接使用默认值
# cp .env.example .env
# Passwords below are dev-only. Production values are not in git.
# See docs/SECURITY-OPS.md.

# ---------- Application image ----------
# Public ACR endpoint. The app server is not in the VPC. See docs/ci-acr.md.
# Local builds ignore the registry: docker compose up -d --build
TELLOMI_IMAGE_REGISTRY=crpi-tge4xmtf4iip17mq.cn-chengdu.personal.cr.aliyuncs.com/tellomi
# 7-character commit SHA of the image to run. deploy-pull.sh sets this from
# git when the value is empty, "local", or "latest". Workstation builds that
# do not call deploy-pull.sh can leave "local" (docker compose up --build).
TELLOMI_IMAGE_TAG=local

# ---------- Tracing ----------
# Empty: services do not export spans and do not log collector errors.
# Set this only when Jaeger (or another OTLP collector) is running.
# TELLOMI_OTEL_ENDPOINT=jaeger:4317

# ---------- GeoIP (DB-IP Lite city MMDB, not committed) ----------
# Host file merged by docker-compose.geoip.yaml. Chengdu: point this at the
# existing DB-IP Lite mmdb. Container path stays the default so both
# authsession and bff open it. See docs/ci-acr.md.
# ip2region (in the image) is used for mainland China session regions.
# DB-IP is used for every other address. Either file may be missing.
# See docs/ip2region.md.
TELLOMI_GEOIP_MMDB_HOST=./data/geoip/dbip-city-lite.mmdb
TELLOMI_GEOIP_MMDB=/app/bin/GeoLite2-City.mmdb
IP2REGION_V4_XDB=/app/data/ip2region/ip2region_v4.xdb
IP2REGION_V6_XDB=/app/data/ip2region/ip2region_v6.xdb

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=teamgram
MYSQL_USER=teamgram
# Dev default. The teamgram container receives this as TEAMGRAM_MYSQL_PASSWORD
# and rewrites teamgram:<password>@tcp(mysql:3306) in /app/etc2. Production
# sets a different value in the host .env. See docs/SECURITY-OPS.md.
MYSQL_PASSWORD=teamgram

# Extra MTProto RSA private key. Leave both unset in dev (gnetway uses the
# upstream key in teamgramd/etc2/gnetway.yaml). Chengdu sets the container
# path under /etc/tellomi/mtproto/ and the public fingerprint.
# TELLOMI_MTPROTO_EXTRA_KEY_FILE=
# TELLOMI_MTPROTO_EXTRA_KEY_FINGERPRINT=

# ---------- MinIO (local profile only) ----------
# Default `docker compose -f docker-compose-env.yaml up` does not start MinIO.
# Local buckets: add `--profile local-minio`. Images are pinned; docker.io/minio
# and quay.io/minio are not anonymously pullable. Override to use a mirror.
# MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-10-26T00-00-00Z
# MINIO_MC_IMAGE=docker.io/pgsty/mc:RELEASE.2026-10-26T00-00-00Z
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniostorage

# ---------- Object storage (dfs). See docs/storage.md ----------
# Local MinIO. For Cloudflare R2 set the endpoint to
# https://<accountid>.r2.cloudflarestorage.com, TELLOMI_S3_REGION=auto,
# and TELLOMI_S3_FORCE_PATH_STYLE=true. Leave TELLOMI_S3_USE_SSL empty:
# an https endpoint turns TLS on, and an explicit false forces plain HTTP
# so dfs cannot read the objects importstickers wrote.
# Buckets must already exist. The server never creates them.
TELLOMI_S3_ENDPOINT=http://minio:9000
TELLOMI_S3_REGION=us-east-1
TELLOMI_S3_ACCESS_KEY_ID=minio
TELLOMI_S3_SECRET_ACCESS_KEY=miniostorage
TELLOMI_S3_FORCE_PATH_STYLE=true
TELLOMI_S3_USE_SSL=
TELLOMI_S3_BUCKET_ATTACHMENTS=tellomi-attachments
TELLOMI_S3_BUCKET_PUBLIC_MEDIA=tellomi-public-media
TELLOMI_S3_BUCKET_BACKUPS=tellomi-backups
# Optional CDN origins. Leave empty for local MinIO.
TELLOMI_S3_PUBLIC_MEDIA_BASE_URL=
TELLOMI_S3_ATTACHMENTS_BASE_URL=
# HTTP CONNECT proxy for this S3 client only. Empty dials the endpoint
# directly and ignores HTTP_PROXY/HTTPS_PROXY. https:// is refused.
# Production is http://172.19.44.222:3128. host:port or http://host:port.
TELLOMI_S3_HTTP_PROXY=

# Deleted-message media purge. See docs/media-purge.md.
# Deletes already enqueue. The media process does not remove objects until
# both of the following are set and the container is recreated. Leave grace
# at 24h. The worker re-checks holders (messages, forwards, avatars, stories,
# stickers, saved GIFs, external refs, legacy paths) before each delete.
# ENABLED=1 with DRY_RUN left true only logs. DRY_RUN=0 without ENABLED does
# not start the loop.
# TELLOMI_MEDIA_PURGE_ENABLED=1
# TELLOMI_MEDIA_PURGE_DRY_RUN=0
TELLOMI_MEDIA_PURGE_ENABLED=false
TELLOMI_MEDIA_PURGE_DRY_RUN=true
TELLOMI_MEDIA_PURGE_GRACE=24h
TELLOMI_MEDIA_PURGE_INTERVAL=1m
TELLOMI_MEDIA_PURGE_BATCH=100

# Crash-report bot @TellomiBot. The account is created by
# migrate-20261125-crash-report-bot.sql. help.getAppConfig publishes
# tellomi_crash_report_bot (default TellomiBot).
# TELLOMI_CRASH_REPORT_TOKEN enables GET /internal/v1/crash-reports on
# 127.0.0.1:8818 inside the container. Leave the token empty to keep the
# listener off. Do not publish the port. The CLI is
# /app/bin/crashreport list -f /app/etc2/bff.yaml
# TELLOMI_CRASH_REPORT_BOT does not rename the account. A value other than
# the username stored for user 777006 is logged at startup and ignored.
# TELLOMI_CRASH_REPORT_BOT=TellomiBot
# TELLOMI_CRASH_REPORT_TOKEN=
# TELLOMI_CRASH_REPORT_ADDR=127.0.0.1:8818
# TELLOMI_CRASH_REPORT_MAX_BYTES=20971520

# ---------- Link preview object reads (not TELLOMI_S3_*) ----------
# Host only, no https://. Local MinIO is the default below.
# Production R2, set before deploy (no secrets in git). See docs/ci-acr.md.
#   TELLOMI_MINIO_ENDPOINT=<accountid>.r2.cloudflarestorage.com
#   TELLOMI_MINIO_REGION=auto
#   TELLOMI_MINIO_USE_SSL=true
#   TELLOMI_MINIO_ACCESS_KEY=<same value as TELLOMI_S3_ACCESS_KEY_ID>
#   TELLOMI_MINIO_SECRET_KEY=<same value as TELLOMI_S3_SECRET_ACCESS_KEY>
#   TELLOMI_MINIO_BUCKET_PHOTOS=tellomi-attachments
#   TELLOMI_MINIO_BUCKET_DOCUMENTS=tellomi-attachments
#   TELLOMI_MINIO_BUCKET_VIDEOS=tellomi-attachments
TELLOMI_MINIO_ENDPOINT=minio:9000
TELLOMI_MINIO_REGION=auto
TELLOMI_MINIO_ACCESS_KEY=
TELLOMI_MINIO_SECRET_KEY=
TELLOMI_MINIO_USE_SSL=false
TELLOMI_MINIO_BUCKET_PHOTOS=tellomi-attachments
TELLOMI_MINIO_BUCKET_DOCUMENTS=tellomi-attachments
TELLOMI_MINIO_BUCKET_VIDEOS=tellomi-attachments

# ---------- Voice and video (1:1) ----------
# Signaling rides the existing MTProto port (prod TCP 10443, staging TCP 11443).
# Media uses coturn on the Docker host. Chengdu (8.137.39.82):
#   TELLOMI_CALL_IP=8.137.39.82
#   TELLOMI_TURN_HOST=8.137.39.82
#   TELLOMI_TURN_SECRET=<same value coturn uses; do not commit it>
#   TELLOMI_TURN_RELAY_IP=<private address on the NIC, if the public IP is an EIP>
# Leave CALL_IP, TURN_HOST, and STUN_HOST empty for localhost. Phone hosts
# in bff.yaml are empty; Normalized() then uses 127.0.0.1 and STUN follows
# TURN. Production sets CALL_IP and TURN_HOST to the public host. STUN_HOST
# is optional when STUN and TURN share that host. Do not put 127.0.0.1 in
# yaml StunHost: TURN_HOST would not replace it.
# Clients receive these addresses on phoneCall.connections after confirmCall,
# not inside phone.getCallConfig. See docs/calls.md.
TELLOMI_CALL_IP=
TELLOMI_CALL_IPV6=
TELLOMI_TURN_HOST=
TELLOMI_TURN_PORT=3478
TELLOMI_STUN_HOST=
TELLOMI_STUN_PORT=3478
TELLOMI_TURN_SECRET=
TELLOMI_TURN_TTL=86400
TELLOMI_TURN_SERVERS=
TELLOMI_STUN_SERVERS=
TELLOMI_TURN_EXTERNAL_IP=
TELLOMI_TURN_RELAY_IP=
TELLOMI_TURN_MIN_PORT=49160
TELLOMI_TURN_MAX_PORT=49200
TELLOMI_ENABLE_P2P=true
TELLOMI_CALL_FORCE_TCP=false

# ---------- Phone RTMP ----------
# Public ingest base URL returned by phone.getGroupCallStreamRtmpUrl.
# The stream key is appended by the server. Default is the local MediaMTX.
TELLOMI_RTMP_URL=rtmp://127.0.0.1:1935/live

# ---------- In-app update (help.getAppUpdate) ----------
# Read by the bff process. Android releases publish
# https://www.tellomi.cn/dl/android/latest.json (synced to Chengdu from R2
# tellomi-updates). Leave MANIFEST empty to read the first local file that
# exists (/etc/tellomi/updates/android/latest.json,
# /opt/tellomi/updates/android/latest.json,
# /var/www/tellomi/dl/android/latest.json,
# /usr/share/nginx/html/dl/android/latest.json) and otherwise that URL.
# Set MANIFEST to a file path or http(s) URL to override. off disables the feed.
# A good read is cached 5 minutes. A timeout (5s) or other failure is cached
# 30 seconds and then answers help.noAppUpdate. Non-empty VERSION is used
# instead of reading the feed.
# The feed's versionName is compared as a dotted marketing version. Optional
# changelog (a string) is the dialog text. url is the button link; fallbackUrl
# is used when url is empty. The dialog is skippable unless CANNOT_SKIP=1 or
# the feed sets "mandatory": true (a JSON boolean; other types are ignored).
# Leave VERSION empty in production. A non-empty VERSION replaces the whole
# manifest and is logged once; it will go stale on the next APK release.
# These values apply to Android and other non-iOS clients. An iOS session
# (lang_pack "ios") always receives help.noAppUpdate. The Telegram iOS client
# shows a blocking page whose button opens App Store id 0, which does nothing
# on TestFlight. iOS sends source "" on help.getAppUpdate, the same value a
# sideload Android build sends, so TELLOMI_APP_UPDATE_SOURCE cannot select iOS.
# VERSION is a dotted marketing version such as 14.0.5. A bare build number
# with no dot (1800979) is ignored and logged once. The client version
# "14.0.4 (1801699) " is compared as 14.0.4.
# TEXT, URL, and SOURCE, when non-empty, replace the manifest fields.
# Empty TEXT uses a short English default. Empty URL omits the link.
# SOURCE matches the method's source argument, case-insensitive. Empty SOURCE
# matches every non-iOS client.
# CANNOT_SKIP=1 keeps the dialog up, including over a feed that is skippable.
# Any other value does not. A feed with "mandatory": true also keeps it up.
# For an env-only release (VERSION set), the dialog is mandatory only when
# CANNOT_SKIP=1.
TELLOMI_APP_UPDATE_MANIFEST=
TELLOMI_APP_UPDATE_VERSION=
TELLOMI_APP_UPDATE_TEXT=
TELLOMI_APP_UPDATE_URL=
TELLOMI_APP_UPDATE_SOURCE=
TELLOMI_APP_UPDATE_CANNOT_SKIP=

# ---------- Venue search (@venue) ----------
# help.getConfig venue_search_username is "venue". The client resolves that
# bot and calls messages.getInlineBotResults. iOS (lang_pack ios, or an
# iPhone/iPad device, or api_id 8) uses Apple Maps. Android (lang_pack
# android, an SDK system version, or api_id 4 or 6) uses AMap. Any other
# client tries Apple, then AMap. A provider runs only when its credentials
# are set. With none set, the bot returns an empty result and the picker
# can still send the current location and a live location.
# Do not commit keys. See docs/venue.md.
TELLOMI_APPLE_MAPS_TEAM_ID=
TELLOMI_APPLE_MAPS_KEY_ID=
TELLOMI_APPLE_MAPS_PRIVATE_KEY_PATH=
TELLOMI_AMAP_KEY=
TELLOMI_AMAP_SIG=
TELLOMI_TENCENT_LBS_KEY=
TELLOMI_AMAP_QPS=3
TELLOMI_AMAP_DAILY=5000
TELLOMI_VENUE_REDIS=redis:6379

# ---------- MTProto flood limits ----------
# enforce returns FLOOD_WAIT_X. log counts and logs without rejecting.
# off disables the limiter. Limits override one bucket: name:burst:per_second.
# TELLOMI_FLOOD_MODE=log
# TELLOMI_FLOOD_LIMITS=send:80:5
# Per-bucket override, comma-separated name:off|log|enforce. Empty follows MODE.
# Roll out by keeping MODE=log and enforcing only high-cost buckets, for example
# send:enforce,send_code_phone:enforce,send_code_ip:enforce
# TELLOMI_FLOOD_BUCKET_MODE=
# TELLOMI_FLOOD_REDIS=redis:6379
TELLOMI_FLOOD_MODE=enforce
TELLOMI_FLOOD_BUCKET_MODE=

# Upload ledger. log records without rejecting. enforce requires the Redis
# address so every replica shares the counters. Empty Redis keeps log mode.
TELLOMI_UPLOAD_LEDGER_MODE=log
TELLOMI_UPLOAD_LEDGER_REDIS=

# ---------- help.getConfig datacenter addresses (M7 / D-33) ----------
# Empty leaves teamgramd/bin/config.json: dc_options [], webfile_dc_id 1,
# dc_txt_domain_name apv2.stel.com. Clients that already stored an address
# keep it when this goes back to empty. See docs/ops/DC_ADDRESSES.md.
# IPv4 literals only, comma-separated dcId:ipv4:port. No hostnames.
# Production keeps DC 2. An empty value plus TELLOMI_PUBLIC_DC_HOST
# publishes DC 1 only. Do not clear a list that includes DC 2.
# TELLOMI_DC_OPTIONS=1:8.137.198.240:10443,1:8.137.198.240:443,2:8.137.198.240:10443,2:8.137.198.240:443
TELLOMI_DC_OPTIONS=
# Public IPv4 written into dc_options. Empty leaves TELLOMI_DC_OPTIONS or the file.
# Dotted IPv4 is rewritten. ipv6 and ::ffff:x.x.x.x stay. Ports other than
# 10443 and 443 are dropped from the reply. An empty list becomes DC 1 on
# 10443 and 443. Does not change gnetway or other hosts.
# TELLOMI_PUBLIC_DC_HOST=8.137.198.240
TELLOMI_PUBLIC_DC_HOST=
# Empty leaves apv2.stel.com. "-" blanks it. Any other value replaces it.
# TELLOMI_DC_TXT_DOMAIN=-
TELLOMI_DC_TXT_DOMAIN=

# ---------- Help center (M1 / D-40) ----------
# 1 makes help.getAppConfig faq_link https://tellomi.cn/help.
# Unset or any other value leaves https://tellomi.cn/faq.
# This process does not serve the page.
# TELLOMI_HELP_CENTER=1

# ---------- About page (D-50 / D-58 / D-59) ----------
# 1 publishes the personalized-recommendation default and the About-page
# strings below. Unset or any other value leaves the switch hidden.
# The filing number is required before the switch default becomes true.
# Empty strings are omitted from help.getAppConfig. Do not put a secret here.
# TELLOMI_ABOUT_DISCLOSURE=1
# TELLOMI_ALGORITHM_FILING_NUMBER=
# TELLOMI_AI_PUBLIC_MODEL=
# TELLOMI_AI_REGISTRATION_NUMBER=

# ---------- Username policy (M5 / D-24 / D-56) ----------
# 1 refuses reserved and lookalike usernames, and display names
# (first name, last name, bio, basic-group and channel title, group
# description, bot name, bot about, bot description). A rejected first name,
# bio, or title is FIRSTNAME_INVALID. A rejected last name is LASTNAME_INVALID.
# Unset or any other value leaves those paths unchanged. Sign-in is not checked.
# Chat messages are not checked.
# TELLOMI_USERNAME_POLICY=1

# ---------- Content safety (M5 P1) ----------
# Unset is off. 1 or aliyun calls Aliyun Green TextModeration
# (nickname_detection, Chengdu). bailian calls TextModerationPlus
# (nickname_detection_pro), the text API used by Bailian's guardrail.
# Han text only. A timeout, HTTP error, or missing key allows the name
# and logs the failure. Keys fall back to ALIBABA_CLOUD_ACCESS_KEY_*.
# TELLOMI_CONTENT_SAFETY=
# TELLOMI_CONTENT_SAFETY_ENDPOINT=
# TELLOMI_CONTENT_SAFETY_SERVICE=
# TELLOMI_CONTENT_SAFETY_TIMEOUT=3s
# TELLOMI_CONTENT_SAFETY_ACCESS_KEY_ID=
# TELLOMI_CONTENT_SAFETY_ACCESS_KEY_SECRET=

# ---------- Discover credential (M3) ----------
# 1 issues discover.getEngineCredential. Unset or any other value returns
# DISCOVER_DISABLED. Both keys are standard base64 of at least 32 bytes and
# must differ. The signing key's raw bytes are the engine's first
# ENGINE_FEED_AUTH_KEYS entry. The pseudonym key never goes to the engine.
# See docs/discover-engine-auth.md. Do not commit key values.
# TELLOMI_DISCOVER=1
# TELLOMI_DISCOVER_SIGNING_KEY=
# TELLOMI_DISCOVER_PSEUDONYM_KEY=

# ---------- Discover relations (M3 / D-13 / D-16 / D-43) ----------
# 1 serves POST /internal/v1/relations/check. Unset is off. The key is
# standard base64 of at least 32 bytes. The engine sends that same base64
# as Authorization: Bearer. Empty ADDR listens on 127.0.0.1:8812. off does
# not listen. See docs/discover-relations.md. Do not commit the key.
# TELLOMI_DISCOVER_RELATIONS=1
# TELLOMI_DISCOVER_RELATION_KEY=
# TELLOMI_DISCOVER_RELATION_ADDR=

# ---------- Discover profile cards (M3 / D-17) ----------
# 1 serves POST /internal/v1/profiles/resolve. Unset does not listen.
# The key is standard base64 of at least 32 bytes, distinct from the
# relation key. Empty ADDR is 127.0.0.1:8816. Subjects come from the
# relation flag above. See docs/discover-profiles.md.
# TELLOMI_DISCOVER_PROFILES=1
# TELLOMI_DISCOVER_PROFILE_KEY=
# TELLOMI_DISCOVER_PROFILE_ADDR=

# ---------- Discover account deletion (M3) ----------
# 1 calls DELETE /internal/users/{sub} after account.deleteAccount.
# Unset does not call the engine and does not block deletion.
# ENGINE_URL is the origin only (https, or http on loopback).
# SERVICE_KEY is standard base64 of ENGINE_SERVICE_KEY, at least 32 bytes.
# The pseudonym key is the one above. See docs/discover-account-deletion.md.
# TELLOMI_DISCOVER_DELETE=1
# TELLOMI_DISCOVER_ENGINE_URL=
# TELLOMI_DISCOVER_SERVICE_KEY=

# ---------- Xiaomi push (M8 / D-68) ----------
# 1 sends account.registerDevice token_type 14 via MiPush. Unset stores the
# token and does not send. APP_SECRET is the MiPush AppSecret. PACKAGE is
# restricted_package_name. HOST empty uses https://api.xmpush.xiaomi.com.
# See docs/push.md. Do not commit the secret.
# TELLOMI_XIAOMI_PUSH=1
# TELLOMI_XIAOMI_APP_SECRET=
# TELLOMI_XIAOMI_PACKAGE=
# TELLOMI_XIAOMI_HOST=

# ---------- FCM push (M8 / D-68) ----------
# 1 sends account.registerDevice token_type 2 via FCM HTTP v1. Unset stores
# the token and does not send. CREDENTIALS is the container path of a
# Firebase service-account JSON. Compose mounts CREDENTIALS_FILE there
# (default /dev/null). PROJECT, HOST, and TOKEN_URL override the file.
# A dial gives up after 8s and does not delay other channels.
# See docs/push.md. Do not commit the JSON file.
# TELLOMI_FCM_PUSH=1
# TELLOMI_FCM_CREDENTIALS=
# TELLOMI_FCM_CREDENTIALS_FILE=
# TELLOMI_FCM_PROJECT=
# TELLOMI_FCM_HOST=
# TELLOMI_FCM_TOKEN_URL=

# ---------- Huawei push (M8 / D-68) ----------
# 1 sends account.registerDevice token_type 13 via Huawei Push Kit. Unset
# stores the token and does not send. APP_ID is the client id. APP_SECRET
# is the client secret. HOST empty uses https://push-api.cloud.huawei.com.
# TOKEN_URL empty uses the China OAuth endpoint. See docs/push.md.
# Do not commit the secret.
# TELLOMI_HUAWEI_PUSH=1
# TELLOMI_HUAWEI_APP_ID=
# TELLOMI_HUAWEI_APP_SECRET=
# TELLOMI_HUAWEI_HOST=
# TELLOMI_HUAWEI_TOKEN_URL=

# ---------- Discover push (M3 / D-18) ----------
# 1 makes sync listen for content-engine interaction events and send them
# through pkg/push. Unset does not listen. The key is standard base64 of at
# least 32 bytes, distinct from the relation key. Empty ADDR is
# 127.0.0.1:8813. See docs/api/discover-ai.md.
# TELLOMI_DISCOVER_PUSH=1
# TELLOMI_DISCOVER_PUSH_KEY=
# TELLOMI_DISCOVER_PUSH_ADDR=

# ---------- Discover link cards ----------
# 1 serves POST /internal/v1/link-preview on bff. Unset does not listen.
# The key is standard base64 of at least 32 bytes. The engine sends that
# same base64 as Authorization: Bearer. Empty ADDR is 127.0.0.1:8817.
# off does not listen. Do not publish the port. This is not the public
# tell.cc resolver on 8801. See docs/api/link-preview-card.md.
# TELLOMI_LINK_PREVIEW=1
# TELLOMI_LINK_PREVIEW_KEY=
# TELLOMI_LINK_PREVIEW_ADDR=

# ---------- @tellomi (M4) ----------
# 1 answers private messages to user 777001 and, with INTERNAL_KEY, serves
# POST /internal/v1/ai/complete for content-engine mentions. Unset does not
# reply and does not change messages.sendMessage. See docs/api/tellomi-ai.md.
# TELLOMI_AI=1
# TELLOMI_AI_API_KEY=
# TELLOMI_AI_BASE_URL=
# TELLOMI_AI_MODEL_PRIMARY=
# TELLOMI_AI_MODEL_SMALL=
# TELLOMI_AI_MODEL_FALLBACK=
# TELLOMI_AI_TIMEOUT_SECONDS=
# TELLOMI_AI_MONTHLY_BUDGET=
# TELLOMI_AI_PRICE_PER_1K=
# TELLOMI_AI_INTERNAL_KEY=
# TELLOMI_AI_ADDR=
# Who may call the model. Blank uses erel,lfnuebfci,pikaqiu.
# * allows everyone. User ids are optional and skip the username lookup.
# TELLOMI_AI_ALLOW_USERNAMES=
# TELLOMI_AI_ALLOW_USER_IDS=
# Fixed replies. Blank keeps the Chinese default in docs/api/tellomi-ai.md.
# TELLOMI_AI_MSG_NOT_ALLOWED=
# TELLOMI_AI_MSG_DAILY=
# TELLOMI_AI_MSG_MINUTE=
# TELLOMI_AI_MSG_CHAT=
# TELLOMI_AI_MSG_BUSY=
# TELLOMI_AI_MSG_BLOCKED=
# TELLOMI_AI_MSG_TEXT_ONLY=
# TELLOMI_AI_MSG_DISABLED=
# TELLOMI_AI_MSG_BUDGET=
# 1 enables messages.translateText and messages.translateRichMessage.
# Unset returns TRANSLATE_REQ_FAILED. The Bailian key above is required.
# TELLOMI_TRANSLATE=1
# 1 enables messages.composeRichMessageWithAI and sets
# tellomi_ai_compose_enabled. Unset returns AICOMPOSE_TIMEOUT.
# TELLOMI_AI_COMPOSE=1

# ---------- Launch notice ----------
# 1 serves POST /internal/v1/announce. Unset does not listen and does not
# change login or messages.sendMessage. The key is standard base64 of at
# least 32 bytes. Empty ADDR is 127.0.0.1:8815. See docs/api/announce.md.
# TELLOMI_ANNOUNCE=1
# TELLOMI_ANNOUNCE_KEY=
# TELLOMI_ANNOUNCE_ADDR=
# TELLOMI_ANNOUNCE_FROM=777001
# TELLOMI_ANNOUNCE_GAP_MS=50

# ---------- Reports ----------
# The @admin (777000) ticket receipt is sent without these. Empty
# TELLOMI_REPORT_REVIEW follows TELLOMI_AI when that flag and the API key
# are set. 0 forces a person. 1 classifies even if TELLOMI_AI is off,
# and still needs TELLOMI_AI_API_KEY. HTTP serves Discover ingest at
# POST /internal/v1/reports. The key is standard base64 of at least 32
# bytes. Empty ADDR is 127.0.0.1:8816, which another container cannot
# reach; set 0.0.0.0:8816 on the docker network and do not publish it.
# See docs/api/reports.md.
# TELLOMI_REPORT_REVIEW=
# TELLOMI_REPORT_HTTP=1
# TELLOMI_REPORT_KEY=
# TELLOMI_REPORT_ADDR=0.0.0.0:8816
# TELLOMI_REPORT_SNAPSHOT=
# TELLOMI_REPORT_SNAPSHOT_BUCKET=
# TELLOMI_REPORT_ETA_HOURS=24

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
