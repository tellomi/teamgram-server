# Environment template for docker-compose-env.yaml and docker-compose.yaml.
# 使用方式: 复制为 .env 后按需修改，或直接使用默认值
# cp .env.example .env
# Passwords below are dev-only. Production values are not in git.
# See docs/SECURITY-OPS.md.

# ---------- Application image ----------
# Public ACR endpoint. The app server is not in the VPC. See docs/ci-acr.md.
# Local builds ignore the registry: docker compose up -d --build
TELLOMI_IMAGE_REGISTRY=crpi-tge4xmtf4iip17mq.cn-chengdu.personal.cr.aliyuncs.com/tellomi
# 7-character commit SHA of the image to run. deploy-pull.sh sets this from
# git when the value is empty, "local", or "latest". Workstation builds that
# do not call deploy-pull.sh can leave "local" (docker compose up --build).
TELLOMI_IMAGE_TAG=local

# ---------- Tracing ----------
# Empty: services do not export spans and do not log collector errors.
# Set this only when Jaeger (or another OTLP collector) is running.
# TELLOMI_OTEL_ENDPOINT=jaeger:4317

# ---------- GeoIP (DB-IP Lite city MMDB, not committed) ----------
# Host file merged by docker-compose.geoip.yaml. Chengdu: point this at the
# existing DB-IP Lite mmdb. Container path stays the default so both
# authsession and bff open it. See docs/ci-acr.md.
# ip2region (in the image) is used for mainland China session regions.
# DB-IP is used for every other address. Either file may be missing.
# See docs/ip2region.md.
TELLOMI_GEOIP_MMDB_HOST=./data/geoip/dbip-city-lite.mmdb
TELLOMI_GEOIP_MMDB=/app/bin/GeoLite2-City.mmdb
IP2REGION_V4_XDB=/app/data/ip2region/ip2region_v4.xdb
IP2REGION_V6_XDB=/app/data/ip2region/ip2region_v6.xdb

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=teamgram
MYSQL_USER=teamgram
# Dev default. The teamgram container receives this as TEAMGRAM_MYSQL_PASSWORD
# and rewrites teamgram:<password>@tcp(mysql:3306) in /app/etc2. Production
# sets a different value in the host .env. See docs/SECURITY-OPS.md.
MYSQL_PASSWORD=teamgram

# Extra MTProto RSA private key. Leave both unset in dev (gnetway uses the
# upstream key in teamgramd/etc2/gnetway.yaml). Chengdu sets the container
# path under /etc/tellomi/mtproto/ and the public fingerprint.
# TELLOMI_MTPROTO_EXTRA_KEY_FILE=
# TELLOMI_MTPROTO_EXTRA_KEY_FINGERPRINT=

# ---------- MinIO (local profile only) ----------
# Default `docker compose -f docker-compose-env.yaml up` does not start MinIO.
# Local buckets: add `--profile local-minio`. Images are pinned; docker.io/minio
# and quay.io/minio are not anonymously pullable. Override to use a mirror.
# MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-10-26T00-00-00Z
# MINIO_MC_IMAGE=docker.io/pgsty/mc:RELEASE.2026-10-26T00-00-00Z
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniostorage

# ---------- Object storage (dfs). See docs/storage.md ----------
# Local MinIO. For Cloudflare R2 set the endpoint to
# https://<accountid>.r2.cloudflarestorage.com, TELLOMI_S3_REGION=auto,
# and TELLOMI_S3_FORCE_PATH_STYLE=true. Leave TELLOMI_S3_USE_SSL empty:
# an https endpoint turns TLS on, and an explicit false forces plain HTTP
# so dfs cannot read the objects importstickers wrote.
# Buckets must already exist. The server never creates them.
TELLOMI_S3_ENDPOINT=http://minio:9000
TELLOMI_S3_REGION=us-east-1
TELLOMI_S3_ACCESS_KEY_ID=minio
TELLOMI_S3_SECRET_ACCESS_KEY=miniostorage
TELLOMI_S3_FORCE_PATH_STYLE=true
TELLOMI_S3_USE_SSL=
TELLOMI_S3_BUCKET_ATTACHMENTS=tellomi-attachments
TELLOMI_S3_BUCKET_PUBLIC_MEDIA=tellomi-public-media
TELLOMI_S3_BUCKET_BACKUPS=tellomi-backups
# Optional CDN origins. Leave empty for local MinIO.
TELLOMI_S3_PUBLIC_MEDIA_BASE_URL=
TELLOMI_S3_ATTACHMENTS_BASE_URL=

# ---------- Link preview object reads (not TELLOMI_S3_*) ----------
# Host only, no https://. Local MinIO is the default below.
# Production R2, set before deploy (no secrets in git). See docs/ci-acr.md.
#   TELLOMI_MINIO_ENDPOINT=<accountid>.r2.cloudflarestorage.com
#   TELLOMI_MINIO_REGION=auto
#   TELLOMI_MINIO_USE_SSL=true
#   TELLOMI_MINIO_ACCESS_KEY=<same value as TELLOMI_S3_ACCESS_KEY_ID>
#   TELLOMI_MINIO_SECRET_KEY=<same value as TELLOMI_S3_SECRET_ACCESS_KEY>
#   TELLOMI_MINIO_BUCKET_PHOTOS=tellomi-attachments
#   TELLOMI_MINIO_BUCKET_DOCUMENTS=tellomi-attachments
#   TELLOMI_MINIO_BUCKET_VIDEOS=tellomi-attachments
TELLOMI_MINIO_ENDPOINT=minio:9000
TELLOMI_MINIO_REGION=auto
TELLOMI_MINIO_ACCESS_KEY=
TELLOMI_MINIO_SECRET_KEY=
TELLOMI_MINIO_USE_SSL=false
TELLOMI_MINIO_BUCKET_PHOTOS=tellomi-attachments
TELLOMI_MINIO_BUCKET_DOCUMENTS=tellomi-attachments
TELLOMI_MINIO_BUCKET_VIDEOS=tellomi-attachments

# ---------- Voice and video (1:1) ----------
# Signaling rides the existing MTProto port (prod TCP 10443, staging TCP 11443).
# Media uses coturn on the Docker host. Chengdu (8.137.39.82):
#   TELLOMI_CALL_IP=8.137.39.82
#   TELLOMI_TURN_HOST=8.137.39.82
#   TELLOMI_TURN_SECRET=<same value coturn uses; do not commit it>
#   TELLOMI_TURN_RELAY_IP=<private address on the NIC, if the public IP is an EIP>
# Leave CALL_IP, TURN_HOST, and STUN_HOST empty for localhost. Phone hosts
# in bff.yaml are empty; Normalized() then uses 127.0.0.1 and STUN follows
# TURN. Production sets CALL_IP and TURN_HOST to the public host. STUN_HOST
# is optional when STUN and TURN share that host. Do not put 127.0.0.1 in
# yaml StunHost: TURN_HOST would not replace it.
# Clients receive these addresses on phoneCall.connections after confirmCall,
# not inside phone.getCallConfig. See docs/calls.md.
TELLOMI_CALL_IP=
TELLOMI_CALL_IPV6=
TELLOMI_TURN_HOST=
TELLOMI_TURN_PORT=3478
TELLOMI_STUN_HOST=
TELLOMI_STUN_PORT=3478
TELLOMI_TURN_SECRET=
TELLOMI_TURN_TTL=86400
TELLOMI_TURN_SERVERS=
TELLOMI_STUN_SERVERS=
TELLOMI_TURN_EXTERNAL_IP=
TELLOMI_TURN_RELAY_IP=
TELLOMI_TURN_MIN_PORT=49160
TELLOMI_TURN_MAX_PORT=49200
TELLOMI_ENABLE_P2P=true
TELLOMI_CALL_FORCE_TCP=false

# ---------- Phone RTMP ----------
# Public ingest base URL returned by phone.getGroupCallStreamRtmpUrl.
# The stream key is appended by the server. Default is the local MediaMTX.
TELLOMI_RTMP_URL=rtmp://127.0.0.1:1935/live

# ---------- In-app update (help.getAppUpdate) ----------
# Read by the bff process. Leave VERSION empty to answer help.noAppUpdate.
# These values apply to Android and other non-iOS clients. An iOS session
# (lang_pack "ios") always receives help.noAppUpdate. The Telegram iOS client
# shows a blocking page whose button opens App Store id 0, which does nothing
# on TestFlight. iOS sends source "" on help.getAppUpdate, the same value a
# sideload Android build sends, so TELLOMI_APP_UPDATE_SOURCE cannot select iOS.
# VERSION is a dotted marketing version such as 14.0.5. A bare build number
# with no dot (1800979) is ignored and logged once. The client version
# "14.0.4 (1801699) " is compared as 14.0.4.
# TEXT is the dialog body. Empty TEXT uses a short English default.
# URL is the button link. Empty URL omits the link.
# SOURCE matches the method's source argument, case-insensitive. Empty SOURCE
# matches every non-iOS client.
# CANNOT_SKIP=1 asks the client to keep the dialog up. Any other value can be dismissed.
TELLOMI_APP_UPDATE_VERSION=
TELLOMI_APP_UPDATE_TEXT=
TELLOMI_APP_UPDATE_URL=
TELLOMI_APP_UPDATE_SOURCE=
TELLOMI_APP_UPDATE_CANNOT_SKIP=

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
